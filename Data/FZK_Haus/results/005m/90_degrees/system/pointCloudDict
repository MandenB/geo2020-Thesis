FoamFile
    {
        version     2.0;
        format      ascii;
        class       dictionary;
        location    "system";
        object      sampleDict;
    }

    functions
    {
        pointCloud
        {
            type                    sets;
            functionObjectLibs      ("libsampling.so");
            interpolationScheme     cellPoint;
            setFormat               raw;

            fields
            (
            U p k epsilon
            );

            sets
            (
                pointCloud
                {
                    type        boxUniform;
                    box         (-24.25 -23.25 0) (24.25 23.25 8.625);
                    nPoints     (242 232 17);
                    axis        xyz;

                }
            );
        }
    }
    
